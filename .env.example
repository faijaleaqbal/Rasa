# ==============================================================================
# Alya Rasa Bot - Environment Template (.env.example)
# ==============================================================================

# 1. Groq LLM & Whisper Audio Transcription
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# 2. Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=Alya_Rasa_Bot
TELEGRAM_WEBHOOK_URL=https://rasaagent.duckdns.org/webhooks/telegram/webhook

# 3. Security Whitelist (Only this numeric Telegram user ID is allowed)
ALLOWED_TELEGRAM_USER_ID=your_telegram_numeric_id_here

# 4. Web Search APIs (Tavily, Serper, DDG fallback)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=

# 5. Google Account OAuth (Gmail, Google Drive, Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 6. Microsoft Graph API (Outlook Email)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REFRESH_TOKEN=

# 7. GitHub & Coding MCP Servers
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_SERVER_URL=
OPENCODE_MCP_SERVER_URL=
ANTIGRAVITY_MCP_SERVER_URL=

# 8. Weather APIs (OpenWeatherMap, WeatherAPI, wttr.in fallback)
OPENWEATHERMAP_API_KEY=
WEATHER_API_KEY=

# 9. News APIs (NewsAPI, GNews, DuckDuckGo News fallback)
NEWSAPI_KEY=
GNEWS_API_KEY=

# 10. Financial & Crypto APIs (ExchangeRate-API, Etherscan)
EXCHANGERATE_API_KEY=
ETHERSCAN_API_KEY=

# 11. Movies & TV Info (OMDb, TMDB, TVMaze fallback)
OMDB_API_KEY=
TMDB_API_KEY=

# 12. Holidays & Festivals (Calendarific, Nager.Date fallback)
CALENDARIFIC_API_KEY=

# 13. Image Stock APIs (Unsplash, Pexels, Wikimedia fallback)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# 14. Security & Threat Intel (HaveIBeenPwned)
HIBP_API_KEY=

# 15. Maps & Navigation (Google Maps Distance Matrix)
GOOGLE_MAPS_API_KEY=

# 16. Science & Space (NASA Open API, WolframAlpha)
NASA_API_KEY=DEMO_KEY
WOLFRAM_APP_ID=
